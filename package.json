{
  "name": "@dk14/mega-peers",
  "repository": {
    "type": "git",
    "url": "https://github.com/dk14/mega-peers.git"
  },
  "version": "0.0.22",
  "description": "A p2p fact sharing network",
  "type": "commonjs",
  "scripts": {
    "test": "c8 npx tsx test/test.ts",
    "it": "npx tsx test/integration.ts",
    "peer": "npx tsx app.ts",
    "mock-oracle": "npx tsx src/client-api/utils/oracle-endpoint.ts",
    "auto-signer": "npx tsx src/client-api/utils/oracle-auto-signer.ts",
    "endpoint-signer": "npx tsx src/client-api/utils/oracle-endpoint-signer.ts",
    "btc-signer": "npx tsx src/client-api/utils/btc-signer.ts",
    "gen-keypair": "npx tsx src/client-api/utils/gen-keypair.ts",
    "demo": "npx tsx test/demo.ts",
    "webtest": "npx tsx esbuild-webapp-ui.ts && cp ./webapp/index.css ./dist/webapp/index.css && npx tsx test/webtest.ts unit",
    "webtest-it": "npx tsx test/webtest-integration.ts",
    "webtest-it-composite": "npx tsx test/webtest-integration.ts notrace composite",
    "webrtc-bridge": "npx tsx test/util/webrtc-bridge.ts",
    "webtest-dsl": "npx tsx src-web/dsl.ts",
    "build": "cp ./mega-peers-spec.yaml dist/mega-peers-spec.yaml && tsc --build && npx tsx esbuild.ts"
  },
  "browser": {
    "openapi-enforcer": false,
    "p2p-node": false,
    "readline": false,
    "@roamhq/wrtc": false
  },
  "exports": {
    "./protocol": "./dist/src/protocol.js",
    "./api": "./dist/src/api.js",
    "./config": "./dist/src/config.js",
    "./p2p": "./dist/src/p2p.js",
    "./p2p-webrtc": "./dist/src/p2p-webrtc.js",
    "./pow": "./dist/src/pow.js",
    "./capability-storage": "./dist/src/client-api/client-storage/capability-storage.js",
    "./trader-storage": "./dist/src/client-api/client-storage/trader-storage.js",
    "./trader-api": "./dist/src/client-api/trader-api.js",
    "./oracle-control-api": "./dist/src/client-api/oracle-control-api.js",
    "./oracle-endpoint-api": "./dist/src/client-api/oracle-endpoint-api.js",
    "./contracts/btc": "./dist/src/client-api/contracts/generate-btc-tx.js",
    "./matching": "./dist/src-web/matching.js",
    "./models": "./dist/src-web/models.js",
    "./oracle-data-provider": "./dist/src-web/oracle-data-provider.js",
    "./stalking": "./dist/src-web/stalking.js",
    "./chain-interpreter": "./dist/src-web/transactions.js",
    "./discreet": "./dist/src-web/dsl.js",
    "./web-to-node": "./dist/test/util/configure.js",
    "./webcfg": "./webcfg.js"
  },
  "bin": {
    "mega-peer": "mega-peer.js",
    "mega-demo": "mega-demo.js",
    "mega-bridge": "mega-bridge.js"
  },
  "keywords": [
    "p2p",
    "oracle"
  ],
  "author": "dk14",
  "license": "ISC",
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^21.1.7",
    "esbuild": "^0.28.1",
    "esbuild-plugin-wasm": "^1.1.0",
    "esbuild-plugins-node-modules-polyfill": "^1.7.0",
    "fake-indexeddb": "^6.0.1",
    "fetch-mock": "^12.5.2",
    "jsdom": "^26.1.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@hyperionbt/helios": "^0.16.7",
    "@nyariv/sandboxjs": "^0.9.6",
    "@roamhq/wrtc": "^0.9.0",
    "@types/node": "^22.13.9",
    "@types/ws": "^8.18.0",
    "asn1js": "^3.0.6",
    "assert": "^2.1.0",
    "async-mutex": "^0.5.0",
    "bigi": "^1.4.2",
    "bip-schnorr": "^0.6.7",
    "bip32": "^4.0.0",
    "bitcoinjs-lib": "^6.1.3",
    "blob-to-arraybuffer": "^0.0.1",
    "bs58": "^6.0.0",
    "crypto": "^1.0.1",
    "darkreader": "^4.9.105",
    "ecpair": "^2.1.0",
    "ecurve": "^1.0.6",
    "filereader": "^0.10.3",
    "http": "^0.0.1-security",
    "http-proxy": "^1.18.1",
    "http-proxy-rules": "^1.1.3",
    "https": "^1.0.0",
    "idb": "^8.0.3",
    "js-sha256": "^0.9.0",
    "js-yaml": "^4.1.0",
    "monaco-editor": "^0.52.2",
    "node-blob": "^0.0.2",
    "node-fetch": "^3.3.2",
    "openapi-enforcer": "^1.23.0",
    "openapi-request-validator": "^12.1.3",
    "p2p-node": "^0.1.1",
    "peer": "^1.0.2",
    "peerjs": "^1.5.4",
    "random-bytes": "^1.0.0",
    "safe-buffer": "^5.2.1",
    "schnorr-adaptor-points": "^0.1.0",
    "serve-handler": "^6.1.6",
    "tiny-secp256k1": "^2.2.2",
    "uint8array-tools": "^0.0.9",
    "url": "^0.11.4",
    "wait-on": "^8.0.3",
    "whatwg-fetch": "^3.6.20",
    "ws": "^8.18.2"
  },
  "files": [
    "dist",
    "cfg",
    "test/cfg",
    "mega-peer.js",
    "mega-demo.js",
    "README.md"
  ],
  "optionalDependencies": {
    "bufferutil": "^4.0.9"
  }
}
